{
  "manifest_version": 3,
  "name": "NightShift",
  "version": "3.0.0",
  "description": "DOM-aware dark theme for reading. Dark / OLED / Dim modes, brightness & contrast, per-site toggle.",
  "permissions": ["storage", "tabs", "contextMenus"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "NightShift",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-nightshift": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Toggle NightShift"
    },
    "cycle-mode": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Cycle Night Mode (Dark -> OLED -> Dim)"
    },
    "toggle-site": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Toggle NightShift on this site"
    }
  }
}